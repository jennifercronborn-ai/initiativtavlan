# Kopiera till .env för att köra skripten lokalt. Lägg ALDRIG .env i GitHub.
SUPABASE_URL=https://<projekt-id>.supabase.co
SUPABASE_ANON_KEY=<anon/public-nyckel>
# Bara för skript och serverfunktioner – aldrig i sidan:
SUPABASE_SERVICE_ROLE_KEY=<service_role-nyckel>
# Valfritt: slår på "Spara och sammanfatta" under Avstämningar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
